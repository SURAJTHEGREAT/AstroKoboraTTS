FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libsndfile1 \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Pre-download models to cache
RUN mkdir -p /app/models_cache
RUN wget -q -O /app/models_cache/kokoro-v1.0.onnx https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files/kokoro-v1.0.onnx
RUN wget -q -O /app/models_cache/voices-v1.0.bin https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files/voices-v1.0.bin

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN chmod +x start.sh

EXPOSE 8000

CMD ["./start.sh"]
